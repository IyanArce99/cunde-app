# Build de PRUEBAS contra catalogo/servidor-pruebas.mjs (local). Sin secretos.
#   npx vite build --mode pruebas --outDir dist-pruebas
# Vite da prioridad a este fichero sobre .env y .env.local en este modo.
VITE_PRECIOS_URL=http://localhost:8787/rest/v1/rpc/instantanea_actual?apikey=pruebas&p_zona={zona}
VITE_SUPABASE_URL=http://localhost:8787
VITE_SUPABASE_ANON_KEY=pruebas
